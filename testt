-- ====================== CORE LOGIC ======================
local bodyVel, bodyGyro, healthConn

local function clearStun(char)
    if not char then return end
    local hum = char:FindFirstChildOfClass("Humanoid")
    if not hum then return end
    for _, v in ipairs(char:GetDescendants()) do
        local n = string.lower(v.Name)
        if (v:IsA("BoolValue") or v:IsA("NumberValue") or v:IsA("IntValue")) then
            if string.find(n, "stun") or string.find(n, "ragdoll") or string.find(n, "freeze")
                or string.find(n, "rooted") or string.find(n, "slow") or string.find(n, "disable") then
                pcall(function()
                    if v:IsA("BoolValue") then v.Value = false else v.Value = 0 end
                end)
            end
        end
    end
    if States.antiStun or States.noRagdoll then
        pcall(function()
            hum:SetStateEnabled(Enum.HumanoidStateType.Physics, false)
            hum:SetStateEnabled(Enum.HumanoidStateType.Ragdoll, false)
            hum:SetStateEnabled(Enum.HumanoidStateType.FallingDown, false)
        end)
    end
end

local function enableGodMode(char)
    if not char then return end
    local hum = char:FindFirstChildOfClass("Humanoid")
    if not hum then return end
    hum.MaxHealth = math.huge
    hum.Health = math.huge
    if healthConn then healthConn:Disconnect() end
    healthConn = hum.HealthChanged:Connect(function()
        if States.godMode then
            hum.Health = math.huge
        end
    end)
end

local function disableGodMode(char)
    if healthConn then healthConn:Disconnect() healthConn = nil end
    if char then
        local hum = char:FindFirstChildOfClass("Humanoid")
        if hum then
            hum.MaxHealth = 100
            hum.Health = 100
        end
    end
end

local function startFly()
    local char = LocalPlayer.Character
    if not char then return end
    local root = char:FindFirstChild("HumanoidRootPart")
    local hum = char:FindFirstChildOfClass("Humanoid")
    if not root or not hum then return end
    hum.PlatformStand = true
    bodyVel = Instance.new("BodyVelocity")
    bodyVel.MaxForce = Vector3.new(9e9, 9e9, 9e9)
    bodyVel.Velocity = Vector3.zero
    bodyVel.Parent = root
    bodyGyro = Instance.new("BodyGyro")
    bodyGyro.MaxTorque = Vector3.new(9e9, 9e9, 9e9)
    bodyGyro.P = 9e4
    bodyGyro.CFrame = root.CFrame
    bodyGyro.Parent = root
end

local function stopFly()
    if bodyVel then bodyVel:Destroy() bodyVel = nil end
    if bodyGyro then bodyGyro:Destroy() bodyGyro = nil end
    local char = LocalPlayer.Character
    if char then
        local hum = char:FindFirstChildOfClass("Humanoid")
        if hum then hum.PlatformStand = false end
    end
end

local function updateESP()
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= LocalPlayer and plr.Character then
            local highlight = plr.Character:FindFirstChild("Silver3zESP")
            if States.esp then
                if not highlight then
                    highlight = Instance.new("Highlight")
                    highlight.Name = "Silver3zESP"
                    highlight.FillColor = currentTheme.accent
                    highlight.OutlineColor = Color3.fromRGB(255, 255, 255)
                    highlight.FillTransparency = 0.55
                    highlight.Parent = plr.Character
                end
            else
                if highlight then highlight:Destroy() end
            end
        end
    end
end

local function onCharacter(char)
    task.wait(0.5)
    clearStun(char)
    if States.flying then stopFly() startFly() end
    if States.godMode then enableGodMode(char) end
end

LocalPlayer.CharacterAdded:Connect(onCharacter)
if LocalPlayer.Character then onCharacter(LocalPlayer.Character) end

RunService.Heartbeat:Connect(function(dt)
    local char = LocalPlayer.Character
    if not char then return end
    local hum = char:FindFirstChildOfClass("Humanoid")
    local root = char:FindFirstChild("HumanoidRootPart")
    if not hum or not root then return end

    if States.antiStun or States.noRagdoll then clearStun(char) end
    if States.godMode then
        hum.MaxHealth = math.huge
        hum.Health = math.huge
    end
    if States.speedHack then hum.WalkSpeed = States.walkSpeed end
    if States.jumpHack then
        hum.JumpPower = States.jumpPower
        hum.JumpHeight = 14
    end

    if States.flying and bodyVel and bodyGyro then
        local camCF = Camera.CFrame
        local dir = Vector3.zero
        if UserInputService:IsKeyDown(Enum.KeyCode.W) then dir = dir + camCF.LookVector end
        if UserInputService:IsKeyDown(Enum.KeyCode.S) then dir = dir - camCF.LookVector end
        if UserInputService:IsKeyDown(Enum.KeyCode.A) then dir = dir - camCF.RightVector end
        if UserInputService:IsKeyDown(Enum.KeyCode.D) then dir = dir + camCF.RightVector end
        if UserInputService:IsKeyDown(Enum.KeyCode.Space) then dir = dir + Vector3.new(0, 1, 0) end
        if UserInputService:IsKeyDown(Enum.KeyCode.LeftControl) then dir = dir - Vector3.new(0, 1, 0) end
        if dir.Magnitude > 0 then dir = dir.Unit * States.flySpeed end
        bodyVel.Velocity = States.flySmooth and bodyVel.Velocity:Lerp(dir, math.clamp(dt * 12, 0, 1)) or dir
        bodyGyro.CFrame = CFrame.new(root.Position, root.Position + camCF.LookVector)
    end

    if States.noclip then
        for _, part in ipairs(char:GetDescendants()) do
            if part:IsA("BasePart") then part.CanCollide = false end
        end
    end
    updateESP()
end)

