        local hum = LocalPlayer.Character:FindFirstChildOfClass("Humanoid")
        if hum then hum:ChangeState(Enum.HumanoidStateType.Jumping) end
    end
end)

local function setToggle(btn, key, onEnable, onDisable)
    btn.MouseButton1Click:Connect(function()
        States[key] = not States[key]
        local on = States[key]
        local base = btn.Text:gsub("  •  ON", ""):gsub("  •  OFF", "")
        btn.Text = base .. (on and "  •  ON" or "  •  OFF")
        btn.BackgroundColor3 = on and currentTheme.on or currentTheme.off
        if on and onEnable then onEnable() end
        if not on and onDisable then onDisable() end
    end)
end

